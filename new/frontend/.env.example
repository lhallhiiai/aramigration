# Frontend Okta configuration. Copy this file to .env.local and fill in
# real values. .env.local is gitignored and must never be committed.
#
# For production, these are passed as Docker build args (see Dockerfile).

VITE_OKTA_ISSUER=https://hii-test.oktapreview.com/oauth2/default
VITE_OKTA_CLIENT_ID=

# Environment name - displayed in the environment banner
# Values: Development, Test, Production
VITE_ENVIRONMENT_NAME=
